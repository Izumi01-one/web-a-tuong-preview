@model PostListVm
@{
    ViewData["Title"] = "Quản trị";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/View_Admin_Index.css"
          asp-append-version="true" />
}

<div class="admin-page">
    <div class="admin-tools">
        <a class="btn btn-primary" href="/quan-tri/dang-bai">
            + Đăng bài
        </a>

        <a class="btn btn-secondary" href="/quan-tri/tai-khoan">
            ⚙ Cấp admin
        </a>

        <form method="post" action="/quan-tri/dang-xuat">
            @Html.AntiForgeryToken()
            <button class="btn btn-logout">Đăng xuất</button>
        </form>
    </div>

    <div class="admin-header-flex">
        <h1>Quản lý bài viết</h1>
    </div>

    <!-- SEARCH FORM -->
    <div class="admin-search-wrapper">
        <form method="get" action="/quan-tri" class="admin-search-form">
            <div class="search-box">
                <svg class="search-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text"
                       name="q"
                       value="@Model.SearchQuery"
                       placeholder="Tìm kiếm bài viết theo tiêu đề, tóm tắt..."
                       class="search-input" />
                @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                {
                    <a href="/quan-tri" class="btn-clear-search" title="Xóa từ khóa">✕</a>
                }
                <button type="submit" class="btn btn-primary btn-search">
                    Tìm kiếm
                </button>
            </div>
        </form>
        <div class="search-meta">
            <span>Tổng cộng: <strong>@Model.TotalCount</strong> bài viết</span>
        </div>
    </div>

    <!-- POST LIST -->
    <div class="post-list" id="post-list">
        <partial name="_AdminItemsPartial" model="Model.Posts" />
    </div>

    @if (!Model.Posts.Any())
    {
        <div class="empty-state">
            <p>Không tìm thấy bài viết nào phù hợp với từ khóa tìm kiếm.</p>
        </div>
    }

    <!-- LOAD MORE CONTAINER -->
    <div class="load-more-container">
        <button id="btn-load-more"
                class="btn-load-more"
                data-skip="@Model.Skip"
                data-query="@Model.SearchQuery"
                style="@(Model.HasMore ? "" : "display: none;")">
            <span class="btn-text">Xem thêm</span>
            <span class="btn-loader" style="display: none;">
                <span class="spinner-dot"></span>
                <span class="spinner-dot"></span>
                <span class="spinner-dot"></span>
            </span>
        </button>
        <div id="no-more-posts" class="no-more-posts" style="@(!Model.HasMore && Model.Posts.Any() ? "" : "display: none;")">
            Đã hiển thị tất cả bài viết
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const loadMoreBtn = document.getElementById('btn-load-more');
            const noMorePosts = document.getElementById('no-more-posts');
            const postList = document.getElementById('post-list');

            if (!loadMoreBtn || !postList) return;

            loadMoreBtn.addEventListener('click', async function () {
                let skip = parseInt(loadMoreBtn.getAttribute('data-skip') || '6', 10);
                const query = loadMoreBtn.getAttribute('data-query') || '';

                loadMoreBtn.disabled = true;
                const btnText = loadMoreBtn.querySelector('.btn-text');
                const btnLoader = loadMoreBtn.querySelector('.btn-loader');
                if (btnText) btnText.style.display = 'none';
                if (btnLoader) btnLoader.style.display = 'inline-flex';

                try {
                    const url = `/quan-tri/load-more?q=${encodeURIComponent(query)}&skip=${skip}&take=6`;
                    const response = await fetch(url);

                    if (!response.ok) {
                        throw new Error('Lỗi khi tải dữ liệu');
                    }

                    const html = await response.text();
                    const hasMore = response.headers.get('X-Has-More') === 'true';

                    postList.insertAdjacentHTML('beforeend', html);

                    skip += 6;
                    loadMoreBtn.setAttribute('data-skip', skip.toString());

                    if (!hasMore) {
                        loadMoreBtn.style.display = 'none';
                        if (noMorePosts) noMorePosts.style.display = 'block';
                    }
                } catch (err) {
                    console.error(err);
                    alert('Có lỗi xảy ra khi tải thêm bài viết. Vui lòng thử lại.');
                } finally {
                    loadMoreBtn.disabled = false;
                    if (btnText) btnText.style.display = 'inline';
                    if (btnLoader) btnLoader.style.display = 'none';
                }
            });
        });
    </script>
}